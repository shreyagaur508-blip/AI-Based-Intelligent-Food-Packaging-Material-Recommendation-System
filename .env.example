# Backend Configuration
PROJECT_NAME="PackWise AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# Database Configuration
# For SQLite (Default Development):
DATABASE_URL="sqlite:///./packwise.db"
# For PostgreSQL (Production Ready):
# DATABASE_URL="postgresql://user:password@localhost:5432/packwise_db"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Frontend Configuration (Vite)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_APP_NAME="PackWise AI"
