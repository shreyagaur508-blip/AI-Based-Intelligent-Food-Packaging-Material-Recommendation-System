# =====================================================================
# PackWise AI - Backend Environment Configuration Template
# =====================================================================

# Application Configuration
APP_NAME="PackWise AI Backend"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api"

# Database Configuration (SQLite default for local development)
DATABASE_URL="sqlite:///./packwise.db"

# CORS Configuration (Allowed frontend origin URLs as JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
